APP_NAME=Sam
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
ANTHROPIC_API_KEY=
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_REFERENCE=
FISH_AUDIO_MODEL=s2.1-pro-free
# Phase 12 (optional): Persian speech via Gemini free tier. Off when blank.
# Sam never enables billing and never falls back to a paid provider.
GEMINI_API_KEY=
GEMINI_TTS_VOICE=Kore
# Optional: your name exactly as it appears in publication author lists, plus any
# aliases you explicitly approve (";"-separated, e.g. "J. Example"). Matching is exact:
# no surname-only match, no guessed initials. Each needs two or more words. Leave blank
# to record no author position.
OWNER_NAME=
OWNER_NAME_ALIASES=
# Phase 15: background proactive scheduling is OFF by default. Set true only if you
# want automations to run from startup (you can also switch it in Automations; that
# switch resets to off on restart unless you tick "Keep scheduling on after Sam
# restarts"). Enabling it grants no permission.
PROACTIVE_SCHEDULER_ENABLED=false
# Phase 17: durable local state. "auto" = SQLite when APP_ENV=production,
# in-memory otherwise. The data directory defaults to the platform app-data
# folder (macOS: ~/Library/Application Support/app.sam.desktop); override only
# with an absolute path. Never point it inside this repository.
SAM_STORAGE=auto
SAM_DATA_DIR=
# Credentials from the macOS Keychain ("auto" = on in production). An
# environment value always wins; a Keychain failure never falls back.
SAM_KEYCHAIN=auto
# Phase 13 (multi-model router). Claude runs through YOUR Claude Code subscription
# login via the local `claude` app: never an API key. There is no OpenAI/xAI setting
# and no paid-fallback switch; Gemini (Free Tier) turns on when GEMINI_API_KEY is set.
CLAUDE_SUBSCRIPTION_ENABLED=true
CLAUDE_CODE_EXECUTABLE=
# owner_local is the only mode in which the Claude subscription provider may run;
# multi_user / hosted / distributed disable it (fail closed).
DEPLOYMENT_MODE=owner_local
DESKTOP_BRIDGE_TOKEN=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_TIMEOUT=30
CLAUDE_MAX_RETRIES=2
DESKTOP_STEP_UP_SECRET=
# Phase 12: owner voice identity (optional; needs `uv sync --group voice-local`)
VOICE_IDENTITY_ENABLED=false
SPEAKER_VERIFICATION_THRESHOLD=0.5
LOCAL_STT_MODEL=small
